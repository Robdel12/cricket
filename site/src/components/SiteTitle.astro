---
import Mark from './Mark.astro';
let { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title">
  <Mark />
  <span translate="no">cricket</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: var(--cr-ink);
    text-decoration: none;
    white-space: nowrap;
    --mark-feelers: var(--cr-amber);
  }
  span {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1;
    padding-bottom: .1em;
  }
  @media (max-width: 50rem) {
    .site-title { gap: .3rem; }
    span { font-size: 1.25rem; }
  }
  @media (max-width: 23.5rem) {
    span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
  .site-title:hover :global(.cricket-mark) { color: var(--sl-color-accent); }
</style>
