---
// Cricket's mark: an empty object literal with antennae. Plain data that
// happens to be a cricket. Braces use currentColor; antennae use --mark-feelers.
// public/favicon.svg draws the same paths with fixed colors.
---
<svg class="cricket-mark" width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <g stroke-linecap="round" stroke-linejoin="round">
    <path d="M13.4 12.6C12.2 7.4 8.6 3.9 3.2 3.4M18.6 12.6C19.8 7.4 23.4 3.9 28.8 3.4" stroke="var(--mark-feelers, currentColor)" stroke-width="1.9" />
    <path d="M12.2 12.4c-2.2 0-3 .9-3 2.8v2.2c0 1.4-.7 2.2-2.3 2.6 1.6.4 2.3 1.2 2.3 2.6v2.2c0 1.9.8 2.8 3 2.8M19.8 12.4c2.2 0 3 .9 3 2.8v2.2c0 1.4.7 2.2 2.3 2.6-1.6.4-2.3 1.2-2.3 2.6v2.2c0 1.9-.8 2.8-3 2.8" stroke="currentColor" stroke-width="2.6" />
  </g>
</svg>
