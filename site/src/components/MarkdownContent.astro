---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { domainFileTypes } from '../../../src/domain.js';
import { guideNavigation } from '../../navigation.js';

let { entry, sidebar } = Astro.locals.starlightRoute;
let landing = Boolean(entry.data.hero);

// The file list follows the types Cricket actually loads, so a new type fails
// the build until it gets a one-line job here.
let jobs = {
  model: ['schema', 'Durable row contracts, visibility, and sensitive fields'],
  validations: ['input', 'Body, params, query, and service input schemas'],
  normalizers: ['source', 'Turns outside data into app data'],
  serializers: ['output', 'Shapes the data your API sends back'],
  service: ['domain', 'Data and integration work'],
  rules: ['access', 'Auth, ownership, billing, and business guards'],
  routes: ['http', 'Composes HTTP behavior from the pieces above'],
  jobs: ['orders', 'Validated work that runs in the background'],
  machine: ['orders', 'Product states and the events that move between them'],
  test: ['behavior', 'Proves it all at the API or worker boundary']
};
let anatomy = [...domainFileTypes, 'test'].map(type => {
  if (!jobs[type]) throw new Error(`Describe the ${type} domain file on the homepage.`);
  let [stem, job] = jobs[type];
  return [`${stem}.${type}.js`, job];
});

let wanted = new Set([...guideNavigation.slice(1).map(group => group.label), 'Reference']);
let groups = sidebar.flatMap(item => item.type === 'group' && wanted.has(item.label)
  ? [{ label: item.label, links: item.entries.filter(link => link.type === 'link') }]
  : []);
---
{landing ? (
  <div class="landing">
    <section class="overview sl-markdown-content" aria-label="What Cricket is">
      <slot />
    </section>

    <section class="anatomy" aria-labelledby="anatomy-title">
      <h2 id="anatomy-title">Every domain has the same shape</h2>
      <p>A domain is a folder of files that change together. Each file has one job and a suffix that says what it is, so you know where code lives before you open anything.</p>
      <ol class="files" aria-label="Files in api/domains/orders/">
        <li class="folder"><span>api/domains/orders/</span></li>
        {anatomy.map(([file, job]) => (
          <li><code>{file}</code><span class="job">{job}</span></li>
        ))}
      </ol>
    </section>

    <nav class="map" aria-labelledby="map-title">
      <h2 id="map-title">Find your way around</h2>
      <div class="columns">
        {groups.map(group => (
          <div>
            <h3>{group.label}</h3>
            <ul>{group.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </nav>
  </div>
) : (
  <Default><slot /></Default>
)}

<style>
  .landing { display: grid; gap: clamp(4rem, 9vw, 7rem); padding-bottom: 3rem; }
  .landing :global(h2) {
    margin: 0;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.6rem);
    line-height: 1.05;
    font-weight: 780;
    letter-spacing: -.02em;
    color: var(--cr-ink);
    text-wrap: balance;
  }

  .anatomy { display: grid; gap: 2rem 4rem; align-items: start; padding-top: 2.5rem; border-top: 2px solid var(--cr-ink); }
  .anatomy > h2 { grid-column: 1 / -1; max-width: 18ch; }
  .anatomy > p { margin: 0; max-width: 36ch; color: var(--sl-color-gray-2); font-size: 1.0625rem; line-height: 1.6; }
  .files { list-style: none; margin: 0; padding: 0; font-size: .95rem; }
  .files li {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    padding-block: .55rem;
    margin: 0;
  }
  .files li:not(.folder) { padding-left: 1.5rem; }
  .files li:not(.folder):not(:last-child) { border-left: 2px solid var(--sl-color-hairline-light); }
  .files li:last-child { border-left: 2px solid transparent; background: linear-gradient(var(--sl-color-hairline-light), var(--sl-color-hairline-light)) 0 0 / 2px 1.2rem no-repeat; }
  .files li:not(.folder)::before {
    content: '';
    flex: 0 0 1rem;
    margin-left: -1.5rem;
    height: 2px;
    align-self: center;
    background: var(--sl-color-hairline-light);
  }
  .folder span { font-family: var(--__sl-font-mono); font-weight: 700; color: var(--cr-ink); }
  .files code {
    flex: none;
    font-family: var(--__sl-font-mono);
    background: none;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .job {
    flex: 1;
    display: flex;
    gap: .75rem;
    color: var(--sl-color-gray-2);
    font-size: .9375rem;
  }
  .job::before {
    content: '';
    flex: 1;
    min-width: 1rem;
    order: -1;
    border-bottom: 2px dotted var(--sl-color-gray-5);
    transform: translateY(-.3em);
  }
  @media (min-width: 62rem) {
    .anatomy { grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); }
  }
  @media (max-width: 40rem) {
    .files li:not(.folder) { flex-wrap: wrap; }
    .job { flex-basis: 100%; }
    .job::before { display: none; }
    .files li:not(.folder)::before { align-self: flex-start; margin-top: .65em; }
  }

  /* The overview guide doubles as the homepage pitch. Its bullet list reads as a grid of short claims. */
  .overview { max-width: none; font-size: 1.0625rem; color: var(--sl-color-gray-2); }
  .overview > :global(p) { max-width: 44rem; }
  .overview > :global(p:first-child) { margin-top: 0; font-size: 1.25rem; line-height: 1.55; color: var(--cr-ink); }
  .overview :global(h2) { margin-top: 3.5rem; }
  .overview :global(ul) { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 2rem 3.5rem; }
  @media (min-width: 50rem) { .overview :global(ul) { grid-template-columns: 1fr 1fr; } }
  .overview :global(li) { margin: 0; padding-top: 1rem; border-top: 2px solid var(--cr-ink); max-width: none; line-height: 1.6; }
  .overview :global(li strong) { display: block; margin-bottom: .4rem; font-size: 1.2rem; color: var(--cr-ink); }

  .columns { display: grid; gap: 2rem 3rem; margin-top: 2rem; }
  @media (min-width: 40rem) { .columns { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 66rem) { .columns { grid-template-columns: repeat(4, 1fr); } }
  .map h3 { font-size: 1rem; font-weight: 700; color: var(--sl-color-gray-3); margin: 0 0 .75rem; }
  .map ul { list-style: none; margin: 0; padding: 0; }
  .map li { margin: 0; }
  .map a {
    display: block;
    padding: .5rem 0;
    font-size: 1.0625rem;
    font-weight: 560;
    color: var(--cr-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }
  .map a:hover { color: var(--sl-color-text-accent); border-bottom-color: currentColor; }
</style>
